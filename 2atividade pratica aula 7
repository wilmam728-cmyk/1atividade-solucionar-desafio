import java.util.Scanner;

public class Practica02 {
    public static void main(String[] args) {
        Scanner scanner = new Scanner(System.in);

        System.out.print("Digite a quantidade de números pares (N): ");
        int n = scanner.nextInt();

        int soma = 0;
        int numeroAtual = 2; // O primeiro número par é 2
        int contadorPares = 0;

        // O laço continua até encontrarmos N números pares
        while (contadorPares < n) {
            soma += numeroAtual;
            numeroAtual += 2; // Avança para o próximo número par
            contadorPares++;
        }

        System.out.println("A soma dos " + n + " primeiros números pares é: " + soma);
        
        scanner.close();
    }
}
